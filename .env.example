# 复制本文件为 .env 后，再填入你要使用的平台 key。
# 这个 Demo 支持多个 provider，前端会自动显示“已配置好 key”的模型。

# DeepSeek 官方 API Key，可选。
DEEPSEEK_API_KEY=

# 服务启动端口，可选；不填默认 3000
PORT=3000

# 服务监听地址，可选；本地开发建议使用 127.0.0.1
HOST=127.0.0.1

# DeepSeek 接口地址，可选；通常不需要修改
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# OpenAI API Key，可选。
OPENAI_API_KEY=

# OpenAI 接口地址，可选；通常不需要修改
OPENAI_API_URL=https://api.openai.com/v1/responses

# OpenAI 推理强度，可选。当前示例模型不支持时，应用会忽略该设置。
OPENAI_REASONING_EFFORT=low

# Moonshot / Kimi API Key，可选；用于 Kimi K2.6 图片理解和普通对话
MOONSHOT_API_KEY=

# Moonshot / Kimi OpenAI-compatible Chat Completions 地址，通常不需要修改
MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions

# SiliconFlow API Key，可选。
SILICONFLOW_API_KEY=

# SiliconFlow 接口地址，可选；通常不需要修改
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions

# 默认角色 ID，可选；前端首次加载时会默认选中这个角色
DEFAULT_ROLE_ID=python-engineer

# RAG 向量数据库配置。
# sqlite：只使用本地 SQLite 存储 chunk/embedding，适合最小 Demo。
# chroma：使用 Chroma 作为向量数据库，SQLite 仍保存聊天记录、文件元数据和 FTS5 关键词检索。
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=chat_demo_documents_bge_m3

# RAG Embedding 配置。
# hash：本地 hash 向量，不需要 API Key，适合 DeepSeek-only 学习环境。
# openai / siliconflow / compatible：真实语义 embedding，需要配置 API Key 和模型。
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
HASH_EMBEDDING_DIMENSIONS=384

# Chroma 的真实数据目录由 Chroma 服务启动参数控制。
# 本项目建议用：
# 1. npm run chroma:venv
# 2. npm run chroma:install
# 3. npm run chroma
# 等价于：.venv\Scripts\chroma.exe run --path ./data/chroma --host 127.0.0.1 --port 8000
# 注意：Node 版 chromadb CLI 在 Windows x64 上不能启动本地 Chroma 服务。
