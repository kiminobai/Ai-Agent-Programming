# 复制本文件为 .env 后，再填入你要使用的平台 key。
# 这个 Demo 支持多个 provider，前端会自动显示“已配置好 key”的模型。

# DeepSeek 官方 API Key，可选。
DEEPSEEK_API_KEY=

# 服务启动端口，可选；不填默认 3000
PORT=3000

# 登录 token 签名密钥；生产环境请改成更长、更随机的字符串
AUTH_TOKEN_SECRET=dev-change-me-chat-demo-token-secret

# 登录有效期，单位秒；604800 = 7 天
AUTH_TOKEN_TTL_SECONDS=604800

# 服务监听地址，可选；本地开发建议使用 127.0.0.1
HOST=127.0.0.1

# DeepSeek 接口地址，可选；通常不需要修改
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# OpenAI API Key，可选。
OPENAI_API_KEY=

# OpenAI 接口地址，可选；通常不需要修改
OPENAI_API_URL=https://api.openai.com/v1/responses

# OpenAI 推理强度，可选。当前示例模型不支持时，应用会忽略该设置。
OPENAI_REASONING_EFFORT=low

# Moonshot / Kimi API Key，可选；用于 Kimi K2.6 图片理解和普通对话
MOONSHOT_API_KEY=

# Moonshot / Kimi OpenAI-compatible Chat Completions 地址，通常不需要修改
MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions

# SiliconFlow API Key，可选。
SILICONFLOW_API_KEY=

# SiliconFlow 接口地址，可选；通常不需要修改
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions

# 默认角色 ID；开发类任务统一由软件工程师角色处理
DEFAULT_ROLE_ID=software-engineer

# RAG 向量数据库配置。
# sqlite：只使用本地 SQLite 存储 chunk/embedding，适合最小 Demo。
# chroma：使用 Chroma 作为向量数据库，SQLite 仍保存聊天记录、文件元数据和 FTS5 关键词检索。
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=chat_demo_documents_bge_m3

# RAG Embedding 配置。
# hash：本地 hash 向量，不需要 API Key，适合 DeepSeek-only 学习环境。
# openai / siliconflow / compatible：真实语义 embedding，需要配置 API Key 和模型。
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3

# GraphRAG 实体/关系抽取方式：
# hybrid = 默认推荐：先用本地规则，规则不足时才调用模型补全
# rule = 只用本地规则，不额外消耗模型 token
# llm = 只用模型抽取，效果更好但成本更高
GRAPH_RAG_ENTITY_EXTRACTOR=hybrid
GRAPH_RAG_EXTRACTOR_PROVIDER=deepseek
GRAPH_RAG_EXTRACTOR_MODEL=deepseek-v4-flash
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
HASH_EMBEDDING_DIMENSIONS=384

# 复杂文档解析配置。
# docling：优先识别 PDF 标题层级、段落、表格、图片、链接和页内坐标；
# Docling 服务未启动或解析失败时，项目会自动回退 LangChain PDFLoader。
# langchain：只使用轻量 PDFLoader，不启动额外服务。
DOCUMENT_PARSER_PROVIDER=docling
DOCLING_URL=http://127.0.0.1:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT_MS=120000
DOCLING_DESCRIBE_PICTURES=true

# Work 模式本地数据根目录（可选）。
# Electron 会自动使用当前系统的“文档/KimiBai”，通常不需要手工配置。
# 仅在使用 npm run start 且希望覆盖默认目录时设置。
KIMIBAI_WORK_DATA_ROOT=

# MCP Client 配置文件。默认读取项目根目录的 mcp.json。
# 密钥不要直接写入 mcp.json；请用 ${env:变量名} 引用这里的环境变量。
MCP_CONFIG_PATH=mcp.json
MCP_REMOTE_TOKEN=

# 用户从界面安装的 Skill 和 MCP 配置目录。
# Electron 自动使用系统“文档/KimiBai/extensions/threads/<threadId>”，通常不需要设置。
# 用户从对话框安装的 Skill/MCP 只属于当前对话，不会被其他对话继承。
KIMIBAI_EXTENSIONS_ROOT=

# Agent 自动上下文压缩。默认按 64k 上下文保守计算：50% 清理旧工具输出，72% 摘要旧消息。
# 如果模型实际上下文不同，只需调整窗口；比例会自动换算成 token 水位。
AGENT_CONTEXT_WINDOW_TOKENS=64000
AGENT_TOOL_COMPACT_RATIO=0.50
AGENT_AUTO_COMPACT_RATIO=0.72
AGENT_AUTO_COMPACT_MESSAGE_LIMIT=100
AGENT_COMPACT_KEEP_MESSAGES=16
AGENT_COMPACT_KEEP_TOOL_RESULTS=6

# 模型限流与成本保护。它们是本应用的保守上限，不会自动读取供应商账户档位。
# RPM/TPM 按 provider + model 分组；并发限制用于削平 Multi-Agent 突发请求。
MODEL_RATE_LIMIT_RPM=60
MODEL_RATE_LIMIT_TPM=60000
MODEL_MAX_CONCURRENT=4
MODEL_USER_DAILY_TOKENS=500000
MODEL_RESERVED_OUTPUT_TOKENS=4096
MODEL_RETRY_TIME_BUDGET_MS=120000

# OpenTelemetry 只发送阶段、模型、Token、耗时和状态，不发送 Prompt、文件正文或私有推理。
# 启动自托管观察服务后，应用统一把 Trace 发到本机 Collector。
OTEL_SERVICE_NAME=kimibai-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS_JSON={}

# Phoenix 追踪界面：http://127.0.0.1:6006。

# BullMQ 异步任务队列。Redis 只保存调度元数据，不保存 Work 对话、记忆或文件正文。
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_WORKER_CONCURRENCY=2
BULLMQ_RETRY_DELAY_MS=1000
BULLMQ_COMPLETED_RETENTION_SECONDS=86400
BULLMQ_FAILED_RETENTION_SECONDS=604800

# Work 模式远程执行隔离。正式环境使用自建 Kubernetes Jobs + gVisor/Kata。
# orchestrator：统一调用 Sandbox 服务；本地 Electron 自动使用 Docker backend，生产使用 Kubernetes backend。
# disabled：仅在明确关闭所有代码执行能力时使用。
SANDBOX_PROVIDER=orchestrator
SANDBOX_ORCHESTRATOR_URL=http://sandbox-orchestrator.kimibai-sandbox.svc.cluster.local:3010
# Agent 后端与 Orchestrator 共用的内部令牌，至少 32 字符；不发送给客户端或执行 Job。
# 正式部署必须由 Secret/环境变量注入。桌面本地留空时由 Electron safeStorage 加密保存，禁止硬编码。
SANDBOX_SERVICE_TOKEN=
# Docker Compose 部署时填写服务器宿主机的绝对路径；Windows 示例使用正斜杠。
SANDBOX_DOCKER_STORAGE_ROOT=F:/studydata/agent/ChatDemo/data/sandboxes
SANDBOX_RUNTIME_CLASS=gvisor
SANDBOX_DEFAULT_IMAGE=node:22-bookworm-slim
# 空闲 10 分钟后删除临时工作区和残留 Job。
SANDBOX_IDLE_TTL_SECONDS=600
SANDBOX_COMMAND_TIMEOUT_SECONDS=900
SANDBOX_MAX_TRANSFER_BYTES=20971520

# Chroma、Docling 与观察服务统一写在根目录 compose.yaml，不再依赖本机 Python/venv。
# 配置好 .env 后统一运行：docker compose up -d
# Chroma 数据保存到 data/chroma，Docling 模型缓存保存到 data/docling-cache。
