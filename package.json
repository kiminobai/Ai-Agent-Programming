{
  "name": "multi-model-chat-demo",
  "version": "1.0.0",
  "description": "A scalable TypeScript chat demo with multiple model providers",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "esbuild client/main.tsx --bundle --outfile=public/app.js --format=iife --platform=browser --target=es2020",
    "start": "tsx src/server.ts",
    "dev": "tsc --watch",
    "dev:serve": "tsx watch src/server.ts"
  },
  "keywords": [
    "typescript",
    "chat",
    "demo",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "openai": "^6.49.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
