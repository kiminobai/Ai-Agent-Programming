{
  "name": "multi-model-chat-demo",
  "version": "1.0.0",
  "description": "A scalable TypeScript chat demo with multiple model providers",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm run build:tailwind && esbuild client/main.tsx --bundle --outfile=public/app.js --format=iife --platform=browser --target=es2020",
    "build:tailwind": "tailwindcss -i client/tailwind.css -o public/tailwind.css --minify",
    "desktop": "npm run build && electron .",
    "desktop:open": "electron .",
    "desktop:full": "npm run services:up && npm run desktop",
    "services:pull": "docker compose pull",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "services:status": "docker compose ps",
    "chroma": "docker compose up -d chroma",
    "docling": "docker compose up -d docling",
    "rag:verify-chunking": "tsx scripts/verifyStructuredChunker.ts",
    "skills:verify": "tsx scripts/verifySkills.ts",
    "kb:index": "tsx scripts/indexKnowledgeBase.ts ai-agent-learning-manual",
    "start": "tsx src/server.ts",
    "dev": "tsc --watch",
    "dev:serve": "tsx watch src/server.ts"
  },
  "keywords": [
    "typescript",
    "chat",
    "demo",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/classic": "^1.0.40",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cheerio": "^1.2.0",
    "chromadb": "^3.5.0",
    "d3-dsv": "^2.0.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "langchain": "^1.5.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "officeparser": "^7.5.1",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.15",
    "electron": "^43.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
