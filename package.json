{
  "name": "multi-model-chat-demo",
  "version": "1.0.0",
  "description": "A scalable TypeScript chat demo with multiple model providers",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm run build:tailwind && esbuild client/main.tsx --bundle --outfile=public/app.js --format=iife --platform=browser --target=es2020",
    "build:tailwind": "tailwindcss -i client/tailwind.css -o public/tailwind.css --minify",
    "chroma": "chat-demo-venv\\Scripts\\chroma.exe run --path ./data/chroma --host 127.0.0.1 --port 8000",
    "chroma:venv": "python -m venv chat-demo-venv",
    "chroma:install": "chat-demo-venv\\Scripts\\python.exe -m pip install chromadb",
    "chroma:node": "chroma run --path ./data/chroma --host 127.0.0.1 --port 8000",
    "kb:index": "tsx scripts/indexKnowledgeBase.ts ai-agent-learning-manual",
    "start": "tsx src/server.ts",
    "dev": "tsc --watch",
    "dev:serve": "tsx watch src/server.ts"
  },
  "keywords": [
    "typescript",
    "chat",
    "demo",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chromadb": "^3.5.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "langchain": "^1.5.3",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.15",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  }
}
